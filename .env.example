PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/crash
# Shared secret between collector and server
INGEST_KEY=change-me
SERVER_URL=http://localhost:3000
# Collector browser: "chrome" (uses installed Google Chrome), "msedge", or empty for Playwright's Chromium
BROWSER_CHANNEL=chrome
BC_URL=https://bc.game/game/crash

# ---- Copy bot (npm run copybot) ----
# Player ID to copy (from the Best players tab; the ID shown in the player drawer)
COPY_PLAYER_ID=
# Fixed amount per bet, in the currency selected in your BC.Game wallet
COPY_STAKE=
# Stop betting for the rest of the UTC day once losses reach this (same currency)
COPY_MAX_DAILY_LOSS=
# Your own auto cash-out as a safety net; the bot cashes out when the target does
COPY_AUTO_CASHOUT=1000
# 1 = log what it would click, no real bets. Set 0 to bet for real.
COPY_DRY_RUN=1
# Main bet-button labels (regex, case-insensitive); adjust if your site language differs
COPY_BTN_BET=^bet$
COPY_BTN_CASHOUT=cash ?out
