{
  "name": "crash-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Live player tracking and round history for a crash game, stored in MongoDB",
  "scripts": {
    "start": "node src/server.js",
    "simulate": "node collector/simulate.js",
    "capture": "node collector/bcgame.js --capture",
    "collect": "node collector/bcgame.js",
    "copybot": "node collector/copybot.js",
    "analyze": "node collector/analyze-capture.js",
    "replay": "node collector/replay.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.12.0",
    "playwright": "^1.64.1",
    "socket.io": "^4.8.4"
  }
}
